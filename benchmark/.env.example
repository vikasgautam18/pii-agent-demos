# PII Shield Benchmark — environment variables
#
# Copy to `.env` (in this folder) and adjust:
#   cp .env.example .env

# ── PII Shield API endpoint (the docker-deployed service) ──────────────────
PII_SHIELD_API_URL=http://localhost:8000
# Optional X-App-Id header for multi-tenant deployments.
# PII_SHIELD_APP_ID=
PII_SHIELD_API_TIMEOUT=120

# ── Docker image used by `compose.yml` ─────────────────────────────────────
PII_SHIELD_IMAGE=ghcr.io/your-org/pii-shield:latest

# ── Workload / harness ─────────────────────────────────────────────────────
BENCH_DATA_FILE=data/messages.jsonl
BENCH_OUT_DIR=results
BENCH_SAMPLES=1000
BENCH_WARMUP=50
BENCH_UNIQUE_MESSAGES=true

# Fake-LLM delay (ms). Substitutes a real LLM call so middleware overhead
# can be isolated from LLM variance.
BENCH_LLM_DELAY_MS=300
BENCH_LLM_YIELD_CHUNKS=1

# Reproducibility.
BENCH_SEED=42

# ── LLM backend ────────────────────────────────────────────────────────────
# "real" (default): FoundryChatClient via AzureCliCredential. Requires
#                   `az login` and the AZURE_AI_* vars below.
# "fake":           asyncio.sleep substitute, free and deterministic. Use
#                   for quick iteration on the harness itself.
BENCH_LLM=real

# Required when BENCH_LLM=real. (Same names the BankingBuddy app uses.)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project-id>
FOUNDRY_MODEL=gpt-5.1

# BankingBuddy — Environment Variables
#
# Copy this file to .env and fill in values:
#   cp .env.example .env

# --- Azure AI Foundry ---
# Project endpoint (from AI Foundry portal → Project → Overview → Endpoint)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<your-project-id>
# Model deployment name (GPT-5.1)
FOUNDRY_MODEL=gpt-5.1

# --- PII Shield Mode ---
# "api" (default): calls PII Shield REST API (requires PII_SHIELD_API_URL)
# "library": imports pii_shield and runs NLP in-process (requires pip install pii-shield)
PII_SHIELD_MODE=api

# PII Shield API URL (required when PII_SHIELD_MODE=api)
PII_SHIELD_API_URL=http://localhost:8000
# Optional app-id for multi-tenant PII Shield (sent as X-App-Id header)
# Run ./scripts/register_app.sh to register and get an app_id.
# PII_SHIELD_APP_ID=
# API call timeout in seconds
# PII_SHIELD_API_TIMEOUT=10

# --- PII Shield NLP Engine (only used when PII_SHIELD_MODE=library) ---
# NLP_ENGINE=onnx
# TRANSFORMERS_MODEL=protectai/bert-base-NER-onnx
# TRANSFORMERS_SPACY_MODEL=en_core_web_sm
# QUANTIZED_MODEL_DIR=models/onnx-int8
# ENCRYPTION_BACKEND=pqc

# --- Streamlit ---
STREAMLIT_PORT=8501
